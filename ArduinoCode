void gyro_signals(void){
  Wire.beginTransmission(0x68); // MPU6050 I2C address
  Wire.write(0x1A); 
  Wire.write(0x05);
  Wire.endTransmission();
  Wire.beginTransmission(0x68);
  Wire.write(0x1C);
  Wire.write(0x10);
  Wire.endTransmission();
  Wire.beginTransmission(0x68);
  Wire.write(0x3B);
  Wire.endTransmission();
  Wire.requestFrom(0x68,6); // Request 6 bytes of data from MPU6050
  int16_t AccXLSB = Wire.read() << 8 | Wire.read(); // Read accelerometer X-axis
  int16_t AccYLSB = Wire.read() << 8 | Wire.read(); // Read accelerometer Y-axis
  int16_t AccZLSB = Wire.read() << 8 | Wire.read(); // Read accelerometer Z-axis
  Wire.beginTransmission(0x68);
  Wire.write(0x1B); // Gyroscope configuration register
  Wire.write(0x8); // Set full scale range to ±500 degrees/s
  Wire.endTransmission();
  Wire.beginTransmission(0x68);
  Wire.write(0x43); // Gyroscope data register
  Wire.endTransmission();
  Wire.requestFrom(0x68,6); // Request 6 bytes of data from MPU6050
  int16_t GyroX = Wire.read() << 8 | Wire.read()<< 8; // Read gyroscope X-axis
  int16_t GyroY = Wire.read() << 8 | Wire.read()<< 8; // Read gyroscope Y-axis
  int16_t GyroZ = Wire.read() << 8 | Wire.read()<< 8; // Read gyroscope Z-axis
  RateRoll = (float)GyroX / 65.5; // Convert to degrees/s
  RatePitch = (float)GyroY / 65.5; // Convert to degrees/s
  RateYaw = (float)GyroZ / 65.5; // Convert to degrees/s
  AccX = (float)AccXLSB / 4096-0.07; // Convert to physial values in g
  AccY = (float)AccYLSB / 4096; // Convert to physial values in g
  AccZ = (float)AccZLSB / 4096+1.83; // Convert to physial values in g
  AngleRoll = atan(AccY / sqrt(AccX * AccX + AccZ * AccZ))*1/(3.142/180); // Calculate roll angle in degrees
//if (AngleRoll <= 0.05 || AngleRoll >= -0.05){
//  AngleRoll = 0.00;
//}
//  Rar = round(AngleRoll * 100);
  AnglePitch = atan(-AccX / sqrt (AccY * AccY + AccZ * AccZ))*1/(3.142/180); // Calculate pitch angle in degrees
//if (AnglePitch <= 0.05 || AnglePitch >= -0.05 ){
//  AnglePitch = 0.00;
//}
//  Rap = round(AnglePitch * 100);
}
